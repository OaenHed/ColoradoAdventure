@{
    ViewData["Title"] = "About Us";
}

<div class="page-header about-header">
    <div class="container text-center text-white py-5">
        <h1 class="display-4 fw-bold">About Colorado Adventure</h1>
        <p class="lead">Our story, mission, and the team behind your adventures</p>
    </div>
</div>

<section class="py-6">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-badge">OUR STORY</span>
                <h2 class="section-title mt-2">Born on the River</h2>
                <p class="lead text-muted">Colorado Adventure was founded in 2010 by lifelong river enthusiast and certified guide Mark Thompson, with a single kayak and an unwavering passion for sharing the beauty of the Colorado River.</p>
                <p>What started as weekend trips with friends quickly grew into Colorado's most trusted kayaking adventure company. Today, we operate 10 distinct tours ranging from family-friendly float trips to expert-level whitewater expeditions, having guided over 5,000 adventurers safely down Colorado's magnificent waterways.</p>
                <p>We believe the river has something to offer everyone - from the parent seeking a gentle family experience to the adrenaline junkie chasing Class V rapids. Our mission is to connect people with the transformative power of nature through safe, expertly guided river adventures.</p>
            </div>
            <div class="col-lg-6">
                <div class="about-image-grid">
                    <img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600" alt="Kayaking adventure" class="img-fluid rounded-3 shadow-lg">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6 bg-light">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="section-badge">OUR VALUES</span>
            <h2 class="section-title">What Drives Us</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-heart"></i></div>
                    <h5>Passion</h5>
                    <p>Every trip is personal to us. We love what we do and it shows in every adventure we guide.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                    <h5>Safety</h5>
                    <p>Your safety is our top priority. All guides hold ACA certifications and wilderness first aid.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-leaf"></i></div>
                    <h5>Conservation</h5>
                    <p>We're stewards of the river. 5% of proceeds go to Colorado River conservation efforts.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="section-badge">THE TEAM</span>
            <h2 class="section-title">Meet Our Expert Guides</h2>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-lg-3 col-md-6 text-center">
                <div class="team-card">
                    <div class="team-avatar" style="background: var(--river-blue);">MT</div>
                    <h5 class="mt-3 mb-1">Mark Thompson</h5>
                    <p class="text-primary small fw-bold">Founder &amp; Lead Guide</p>
                    <p class="text-muted small">ACA Level 4 Instructor, 20+ years experience on Colorado River</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 text-center">
                <div class="team-card">
                    <div class="team-avatar" style="background: var(--canyon-red);">SR</div>
                    <h5 class="mt-3 mb-1">Sarah Rodriguez</h5>
                    <p class="text-primary small fw-bold">Senior Guide</p>
                    <p class="text-muted small">Grand Canyon specialist, wilderness EMT, 15 years experience</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 text-center">
                <div class="team-card">
                    <div class="team-avatar" style="background: var(--forest-green);">JW</div>
                    <h5 class="mt-3 mb-1">Jake Wilson</h5>
                    <p class="text-primary small fw-bold">Whitewater Specialist</p>
                    <p class="text-muted small">Expert whitewater guide, Westwater &amp; Gore Canyon specialist</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 text-center">
                <div class="team-card">
                    <div class="team-avatar" style="background: var(--canyon-red);">AL</div>
                    <h5 class="mt-3 mb-1">Amy Lee</h5>
                    <p class="text-primary small fw-bold">Family Tours Guide</p>
                    <p class="text-muted small">Certified children's paddling instructor, 8 years experience</p>
                </div>
            </div>
        </div>
    </div>
</section>
