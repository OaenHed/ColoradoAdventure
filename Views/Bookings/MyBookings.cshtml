@model IEnumerable<ColoradoAdventure.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="page-header">
    <div class="container text-white py-5">
        <h1 class="display-5 fw-bold">My Bookings</h1>
        <p class="lead">Manage your Colorado River adventures</p>
    </div>
</div>

<section class="py-5">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-calendar-times fa-4x text-muted mb-4"></i>
                <h3 class="text-muted">No bookings yet</h3>
                <p class="text-muted">Start your Colorado River adventure today!</p>
                <a asp-controller="Tours" asp-action="Index" class="btn btn-adventure btn-lg mt-2">
                    Browse Tours
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle bookings-table">
                    <thead class="table-dark">
                        <tr>
                            <th>Tour</th>
                            <th>Trip Date</th>
                            <th>Guests</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@booking.Tour.ImageUrl" alt="@booking.Tour.Name"
                                             class="rounded" width="60" height="40" style="object-fit:cover">
                                        <div>
                                            <strong>@booking.Tour.Name</strong>
                                            <div class="small text-muted">@booking.Tour.Difficulty | @booking.Tour.Duration</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@booking.TripDate.ToString("MMM dd, yyyy")</td>
                                <td>@booking.NumberOfPeople</td>
                                <td class="fw-bold text-primary">$@booking.TotalPrice</td>
                                <td>
                                    @{
                                        var badgeClass = booking.Status switch {
                                            ColoradoAdventure.Models.BookingStatus.Confirmed => "bg-success",
                                            ColoradoAdventure.Models.BookingStatus.Cancelled => "bg-danger",
                                            ColoradoAdventure.Models.BookingStatus.Completed => "bg-info",
                                            _ => "bg-warning text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@booking.Status</span>
                                </td>
                                <td>
                                    @if (booking.Status == ColoradoAdventure.Models.BookingStatus.Pending || booking.Status == ColoradoAdventure.Models.BookingStatus.Confirmed)
                                    {
                                        <form asp-action="Cancel" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel this booking?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@booking.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                        </form>
                                    }
                                    <a asp-controller="Tours" asp-action="Details" asp-route-id="@booking.TourId"
                                       class="btn btn-sm btn-outline-primary ms-1">View Tour</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
