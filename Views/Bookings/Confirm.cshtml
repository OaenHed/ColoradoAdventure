@model ColoradoAdventure.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed!";
}

<section class="py-6">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 text-center">
                <div class="confirm-card">
                    <div class="confirm-icon mb-4">
                        <i class="fas fa-check-circle text-success fa-5x"></i>
                    </div>
                    <h2 class="fw-bold mb-2">Booking Confirmed!</h2>
                    <p class="lead text-muted mb-4">Your adventure awaits! Booking #@Model.Id has been received.</p>

                    <div class="booking-details-card mb-4">
                        <div class="detail-row">
                            <span>Tour</span>
                            <strong>@Model.Tour.Name</strong>
                        </div>
                        <div class="detail-row">
                            <span>Trip Date</span>
                            <strong>@Model.TripDate.ToString("MMMM dd, yyyy")</strong>
                        </div>
                        <div class="detail-row">
                            <span>Guests</span>
                            <strong>@Model.NumberOfPeople people</strong>
                        </div>
                        <div class="detail-row">
                            <span>Status</span>
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        </div>
                        <div class="detail-row">
                            <span>Total</span>
                            <strong class="text-primary fs-5">$@Model.TotalPrice</strong>
                        </div>
                    </div>

                    <p class="text-muted small mb-4">A confirmation email has been sent to your registered email address. Our team will contact you within 24 hours to finalize your booking.</p>

                    <div class="d-flex gap-3 justify-content-center">
                        <a asp-action="MyBookings" class="btn btn-adventure">View My Bookings</a>
                        <a asp-controller="Tours" asp-action="Index" class="btn btn-outline-primary">Explore More Tours</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
