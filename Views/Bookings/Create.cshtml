@model ColoradoAdventure.Models.Booking
@{
    ViewData["Title"] = "Book Your Adventure";
    var tour = ViewBag.Tour as ColoradoAdventure.Models.Tour;
}

<div class="page-header">
    <div class="container text-center text-white py-5">
        <h1 class="display-5 fw-bold">Book Your Adventure</h1>
        <p class="lead">@tour?.Name</p>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row g-5 justify-content-center">
            <div class="col-lg-7">
                <div class="booking-form-card">
                    <h3 class="mb-4"><i class="fas fa-calendar-plus me-2 text-primary"></i>Booking Details</h3>
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TourId" />

                        <div class="mb-4">
                            <label asp-for="TripDate" class="form-label fw-semibold">
                                <i class="fas fa-calendar me-2 text-primary"></i>Select Trip Date
                            </label>
                            <input asp-for="TripDate" type="date" class="form-control form-control-lg"
                                   min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required>
                            <span asp-validation-for="TripDate" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NumberOfPeople" class="form-label fw-semibold">
                                <i class="fas fa-users me-2 text-primary"></i>Number of People
                            </label>
                            <input asp-for="NumberOfPeople" type="number" class="form-control form-control-lg"
                                   min="1" max="@tour?.MaxCapacity" placeholder="1" required
                                   oninput="updateTotal(this.value)">
                            <div class="form-text">Maximum @tour?.MaxCapacity people per tour</div>
                            <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold">
                                <i class="fas fa-comment me-2 text-primary"></i>Special Requests (Optional)
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="Any dietary restrictions, accessibility needs, or special requests..."></textarea>
                        </div>

                        <div class="price-summary mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold">Price per person:</span>
                                <span>$@tour?.Price</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-semibold">Number of people:</span>
                                <span id="peopleCount">1</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-5">Total:</span>
                                <span class="fw-bold fs-4 text-primary" id="totalPrice">$@tour?.Price</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-adventure btn-lg w-100">
                            <i class="fas fa-check-circle me-2"></i>Confirm Booking
                        </button>
                    </form>
                </div>
            </div>
            <div class="col-lg-4">
                @if (tour != null)
                {
                    <div class="tour-summary-card">
                        <img src="@tour.ImageUrl" alt="@tour.Name" class="img-fluid rounded-3 mb-3">
                        <h5>@tour.Name</h5>
                        <div class="d-flex gap-3 text-muted small mb-2">
                            <span><i class="fas fa-clock me-1"></i>@tour.Duration</span>
                            <span><i class="fas fa-mountain me-1"></i>@tour.Difficulty</span>
                        </div>
                        <div class="border-top pt-3 mt-2">
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <i class="fas fa-shield-alt text-success"></i>
                                Free cancellation up to 48 hours before your trip
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const pricePerPerson = @(tour?.Price ?? 0);
        function updateTotal(people) {
            const n = parseInt(people) || 1;
            document.getElementById('peopleCount').textContent = n;
            document.getElementById('totalPrice').textContent = '$' + (pricePerPerson * n).toFixed(2);
        }
    </script>
}
