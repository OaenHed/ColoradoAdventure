@model IEnumerable<ColoradoAdventure.Models.Booking>
@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="admin-header py-4">
    <div class="container">
        <h1 class="fw-bold"><i class="fas fa-calendar-alt me-2"></i>Manage Bookings</h1>
    </div>
</div>

<section class="py-4">
    <div class="container">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Tour</th>
                        <th>Customer</th>
                        <th>Trip Date</th>
                        <th>Guests</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Booked On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>#@b.Id</td>
                            <td>@b.Tour?.Name</td>
                            <td>@b.User?.Email</td>
                            <td>@b.TripDate.ToString("MMM dd, yyyy")</td>
                            <td>@b.NumberOfPeople</td>
                            <td class="fw-bold">$@b.TotalPrice</td>
                            <td>
                                @{
                                    var cls = b.Status switch {
                                        ColoradoAdventure.Models.BookingStatus.Confirmed => "bg-success",
                                        ColoradoAdventure.Models.BookingStatus.Cancelled => "bg-danger",
                                        ColoradoAdventure.Models.BookingStatus.Completed => "bg-info",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @cls">@b.Status</span>
                            </td>
                            <td>@b.CreatedDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
